# ── Model ─────────────────────────────────────────────
# Path or name of the YOLO checkpoint. If a bare name like "yolov8n" is
# given, Ultralytics will attempt to download it at startup (~6 MB for
# yolov8n.pt). To use custom-trained weights, point this at the .pt file,
# e.g. MODEL_PATH=/path/to/models/best.pt
MODEL_PATH=yolov8n

# Inference device: "auto" (cuda if available, else cpu), "cpu", "cuda", "cuda:0"
DEVICE=auto

# Default confidence threshold used when the client doesn't supply one
DEFAULT_CONFIDENCE=0.25

# ── Uploads ───────────────────────────────────────────
MAX_UPLOAD_MB=10
# Max video upload size / length (MB / seconds)
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=60
# Every Nth frame is processed (1 = every frame)
VIDEO_FRAME_STRIDE=5

# ── Server ────────────────────────────────────────────
PORT=8000
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173
